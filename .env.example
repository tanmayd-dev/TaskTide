# TaskTide environment
# Copy to .env before running:  cp .env.example .env

# --- Postgres ---
POSTGRES_USERNAME=tasktide
POSTGRES_PASSWORD=tasktide
# Used for local dev only; Compose builds this string itself for the containers.
POSTGRES_DBSTRING=postgres://tasktide:tasktide@localhost:5432/TaskTide?sslmode=disable

# --- MinIO / S3 ---
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_HOST=localhost
MINIO_PORT=9000
FILES_BUCKET_NAME=tasktide-files

# --- Services ---
# These ports are internal to the Compose network; no service except the
# frontend (127.0.0.1:3001) is published on the host.
# API_PORT is shared by the api service and the frontend's nginx proxy.
API_HOST=0.0.0.0
API_PORT=8080
QUEUE_HOST=localhost
QUEUE_PORT=8081
# Leave WORKER_HOST empty: the worker registers under its own hostname.
# It binds an OS-assigned port and advertises that, so no WORKER_PORT is needed.
WORKER_HOST=

# --- Task tuning ---
NOOP_TIME=2
