# TaskTide environment
# Copy to .env before running:  cp .env.example .env

# --- Postgres ---
POSTGRES_USERNAME=tasktide
POSTGRES_PASSWORD=tasktide
# Used for local dev and the E2E harness only; Compose builds this string
# itself for the containers. 55432 is the loopback host publish of postgres
# (see docker-compose.yaml).
POSTGRES_DBSTRING=postgres://tasktide:tasktide@localhost:55432/TaskTide?sslmode=disable

# --- MinIO / S3 ---
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_HOST=localhost
MINIO_PORT=9000
FILES_BUCKET_NAME=tasktide-files

# --- Services ---
# These ports are internal to the Compose network. Only loopback-only host
# publishes exist, and solely for host-side tooling (E2E harness, CLI, psql,
# MinIO console): postgres 55432, api/queue/50051, minio 9000/9001. The
# frontend (127.0.0.1:3001) is the only end-user-facing entry point.
# API_PORT is shared by the api service and the frontend's nginx proxy.
API_HOST=0.0.0.0
API_PORT=8080
QUEUE_HOST=localhost
QUEUE_PORT=8081
# Leave WORKER_HOST empty: the worker registers under its own hostname.
# It binds an OS-assigned port and advertises that, so no WORKER_PORT is needed.
WORKER_HOST=

# --- Task tuning ---
NOOP_TIME=2

# Test-only failure simulators required by scripts/endToEnd.go (retry, DLQ
# and idempotency cases rely on them). Leave unset or false in production.
ENABLE_TEST_SIMULATORS=

