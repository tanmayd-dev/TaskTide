# TaskTide frontend: static SPA + reverse proxy to the `api` service.
#
# This is a template, not a plain nginx config. The official nginx image's
# entrypoint runs `envsubst` over /etc/nginx/templates/*.template at container
# start and writes the output to /etc/nginx/conf.d/default.conf. Only container
# env vars that are actually defined get substituted, so nginx runtime
# variables such as $uri, $host and $scheme are left intact.
#
# ${API_PORT} is the port the `api` service listens on inside the Compose
# network; docker-compose.yaml passes the same ${API_PORT} to both services so
# the two sides cannot drift.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The Go API mounts its routes at the server root (/workflow, /file, ...),
    # so the /api prefix is stripped by proxy_pass's trailing slash:
    #   /api/workflow/list -> http://api:<port>/workflow/list
    location /api/ {
        proxy_pass http://api:${API_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # File uploads/downloads: don't cap the body, don't buffer to disk
        # before forwarding, and allow slow transfers.
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SPA fallback: unknown paths (client-side routes) resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
